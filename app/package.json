{
  "name": "tuition-invoice-maker",
  "productName": "Tuition Invoice Maker",
  "version": "1.3.0",
  "description": "Monthly invoices for private tuition",
  "author": "Denlopen",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "INVOICE_SELFTEST=1 INVOICE_DATA_DIR=./.selftest electron .",
    "dist:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "io.github.denlopen.tuitioninvoice",
    "productName": "Tuition Invoice Maker",
    "files": [
      "main.js",
      "preload.js",
      "selftest.js",
      "renderer/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tuition Invoice Maker",
      "artifactName": "Tuition-Invoice-Maker-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Tuition-Invoice-Maker-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
