{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cikgu Pay",
  "version": "1.5.0",
  "identifier": "io.github.denlopen.tuitioninvoice.tauri",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node scripts/sync-ui.mjs",
    "beforeBuildCommand": "node scripts/sync-ui.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Cikgu Pay: invoices and lesson summaries for private tutors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
