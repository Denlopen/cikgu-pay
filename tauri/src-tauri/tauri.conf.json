{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuition Invoice Maker",
  "version": "1.3.0",
  "identifier": "io.github.denlopen.tuitioninvoice.tauri",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node scripts/sync-ui.mjs",
    "beforeBuildCommand": "node scripts/sync-ui.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Monthly invoices for private tuition",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
